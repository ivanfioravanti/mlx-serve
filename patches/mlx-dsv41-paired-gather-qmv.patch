-template <typename T, int group_size, int bits, bool has_global_scale = false>
+// Consecutive input rows assigned to the same expert share the packed words
+// and scale. Each row retains qdot's four-product groups and SIMD reduction.
+template <int V, typename T>
+METAL_FUNC bool fp_try_paired_rows(
+    const device uint32_t* w,
+    const device uint8_t* scales,
+    const device T* x,
+    const device uint32_t* lhs_indices,
+    const device uint32_t* rhs_indices,
+    device T* y,
+    int K,
+    int N,
+    int rows,
+    int64_t w_stride,
+    int64_t scale_stride,
+    uint3 tid,
+    uint simd_gid,
+    uint lane) {
+  const uint first = tid.z & ~1u;
+  if (first + 1 >= uint(rows) ||
+      rhs_indices[first] != rhs_indices[first + 1] ||
+      lhs_indices[first + 1] != lhs_indices[first] + 1) {
+    return false;
+  }
+  if (tid.z != first) {
+    return true;
+  }
+
+  w += size_t(rhs_indices[first]) * w_stride;
+  scales += size_t(rhs_indices[first]) * scale_stride;
+  x += size_t(lhs_indices[first]) * K;
+  y += size_t(first) * N;
+  const uint col = tid.y * 8 + simd_gid * 4;
+  float sum0[4] = {}, sum1[4] = {};
+  for (int k = lane * V; k < K; k += 32 * V) {
+    float x0[V], x1[V];
+    for (int v = 0; v < V; ++v) {
+      x0[v] = float(x[k + v]);
+      x1[v] = float(x[K + k + v]);
+    }
+    for (int j = 0; j < 4; ++j) {
+      const size_t row = col + j;
+      const device ushort* codes =
+          (const device ushort*)(w + row * (K / 8) + k / 8);
+      const float scale = dequantize_scale<float, 32>(
+          scales[row * (K / 32) + k / 32]);
+      float dot0 = 0, dot1 = 0;
+#pragma unroll
+      for (int v = 0; v < V; v += 4) {
+        const uint word = codes[v / 4];
+        const float w0 = Dequantize<4>{}(word);
+        const float w1 = Dequantize<4>{}(word >> 4);
+        const float w2 = Dequantize<4>{}(word >> 8);
+        const float w3 = Dequantize<4>{}(word >> 12);
+        dot0 += x0[v] * w0 + x0[v + 1] * w1 +
+            x0[v + 2] * w2 + x0[v + 3] * w3;
+        dot1 += x1[v] * w0 + x1[v + 1] * w1 +
+            x1[v + 2] * w2 + x1[v + 3] * w3;
+      }
+      sum0[j] += scale * dot0;
+      sum1[j] += scale * dot1;
+    }
+  }
+  for (int j = 0; j < 4; ++j) {
+    const float a = simd_sum(sum0[j]);
+    const float b = simd_sum(sum1[j]);
+    if (lane == 0) {
+      y[col + j] = T(a);
+      y[N + col + j] = T(b);
+    }
+  }
+  return true;
+}
